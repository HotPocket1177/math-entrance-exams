# ════════════════════════════════════════════════════════════════
# .env.example — dokumentace proměnných prostředí
# Zkopíruj do .env a vyplň skutečné hodnoty.
# NIKDY necommituj .env do gitu!
# ════════════════════════════════════════════════════════════════

# ── Supabase (veřejné — bezpečné pro frontend / config.js) ──────
# Najdeš v: supabase.com → tvůj projekt → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Anthropic / Claude (SECRET — pouze do Supabase secrets, NIKDY na frontend) ──
# Nastav přes: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Tento klíč NESMÍ být nikdy v config.js ani v žádném JS souboru!
ANTHROPIC_API_KEY=sk-ant-...

# Volitelně jiný model (výchozí claude-haiku-5-5 — levný), např. silnější claude-opus-5-5
# Nastav přes: supabase secrets set ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL=claude-haiku-5-5

# ── CORS (volitelné — Edge Function) ────────────────────────────
# Doména odkud frontend volá Edge Function.
# "*" = povolení všech (vhodné pro vývoj, v produkci upřesni)
# Nastav přes: supabase secrets set ALLOWED_ORIGIN=https://tvoje-domena.cz
ALLOWED_ORIGIN=https://matika.bischofstein.net
